# ============================================================
# GymBattle — variáveis de ambiente
# Copie para ".env" (na raiz do projeto) e preencha.
# NUNCA faça commit do arquivo .env.
# ============================================================

# Ambiente: development | production
# Em produção NÃO precisa definir: o servidor assume "production" sozinho.
# (Na Hostinger, definir NODE_ENV=production pode impedir a instalação das
#  ferramentas de build.) Para rodar no seu computador, descomente:
# NODE_ENV=development

# Porta do servidor Node (na hospedagem, normalmente é definida automaticamente)
PORT=3000

# URL pública do site (usada para CORS, cookies e links). Ex.: https://gymbattle.com.br
PUBLIC_URL=http://localhost:5173

# Conexão MySQL (Hostinger: painel → Bancos de Dados MySQL)
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
DATABASE_URL=mysql://gym:gympass@127.0.0.1:3306/gymbattle

# Segredo para assinar os tokens de sessão (JWT). Use 64+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (o servidor recusa valores de exemplo ou fáceis de adivinhar)
JWT_SECRET=

# Segredo usado para guardar o CPF de forma irreversível (só um "hash", nunca o número).
# Opcional: se não definir, é derivado do JWT_SECRET. IMPORTANTE: depois que houver
# contas com CPF, não troque este valor (nem o JWT_SECRET, se este estiver vazio),
# senão o bloqueio de "um CPF por conta" deixa de reconhecer os CPFs antigos.
# CPF_SECRET=

# Duração da sessão em dias
SESSION_DAYS=30

# Conta administradora. O e-mail é fixo; a senha é lida daqui e salva com hash
# (criada automaticamente na primeira vez que o servidor sobe, ou com npm run db:seed).
# Use uma senha longa (16+ caracteres). Depois dá para trocar em Perfil → Trocar senha.
ADMIN_EMAIL=lucasmartins2216@gmail.com
ADMIN_PASSWORD=

# Pasta onde as fotos (WebP) são salvas.
# Em produção, se não definir, usa ~/gymbattle-data/uploads (FORA da pasta do
# build, para as fotos não sumirem a cada deploy).
UPLOAD_DIR=./uploads

# Cookie "Secure" (exige HTTPS). Em produção já é true por padrão.
# Só para testar em http://localhost, descomente:
# COOKIE_SECURE=false

# Aplica as migrations do banco automaticamente ao iniciar (padrão: true)
# AUTO_MIGRATE=true

# Notificações push no celular (opcional). Se não definir, o servidor gera as
# chaves sozinho na primeira vez e guarda no banco.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
